# Example configuration: `xcaddy run --config Caddyfile`
{
	admin localhost:2019

	# Defaults inherited by every cache directive below.
	cache {
		path /tmp/caddy-cache
		max_size 1Gi
		max_memory 128Mi
		ttl 120s
	}
}

:8080 {
	# Cached for the default 120s.
	route /default {
		cache
		respond "Hello, default!"
	}

	# The response says how long it is fresh.
	route /max-age {
		cache
		header Cache-Control "max-age=5"
		respond "Hello, max-age!"
	}

	# Served stale for up to 30s while it is updated or if the upstream fails.
	route /stale {
		cache {
			ttl 5s
			stale 30s
		}
		respond "Hello, stale!"
	}

	# Kept in memory only at first, written to disk at its second request.
	route /min-uses {
		cache {
			min_uses 2
		}
		respond "Hello, again!"
	}

	# One stored response per value of the X-Something request header.
	route /vary {
		cache {
			ttl 15s
		}
		header Vary X-Something
		respond "Hello {http.request.header.X-Something}"
	}

	# Compressed and uncompressed variants are stored separately.
	route /gzip {
		cache
		encode gzip
		header Content-Type text/plain
		respond "Hello, gzip. Hello, gzip. Hello, gzip. Hello, gzip. Hello, gzip. Hello, gzip. Hello, gzip. Hello, gzip."
	}

	# Query parameters do not make a different response.
	route /no-query {
		cache {
			key {
				disable_query
			}
		}
		respond "Hello, whatever the query!"
	}

	# One response per user: Authorization is part of the key.
	route /authenticated {
		cache {
			key {
				headers Authorization
			}
		}
		respond "Hello to the authenticated user."
	}

	# Request Cache-Control directives are obeyed.
	route /strict {
		cache {
			mode strict
		}
		respond "Hello, strict!"
	}

	# Response Cache-Control directives are ignored.
	route /bypass {
		cache {
			mode bypass_response
		}
		header Cache-Control "no-store"
		respond "Hello, bypass!"
	}

	route /another-cache-status-name {
		cache {
			cache_name Another
		}
		respond "Hello, Another!"
	}

	route /not-found {
		cache {
			allowed_additional_status_codes 404
		}
		respond "Nothing here" 404
	}

	route /proxy/* {
		cache {
			regex {
				exclude ^/proxy/private/
			}
		}
		reverse_proxy 127.0.0.1:9000
	}
}
