{
  "admin": {
    "listen": "localhost:2019"
  },
  "apps": {
    "cache": {
      "path": "/tmp/caddy-cache",
      "max_size": "1Gi",
      "max_memory": "128Mi",
      "ttl": "120s"
    },
    "http": {
      "servers": {
        "example": {
          "listen": [":8080"],
          "routes": [
            {
              "match": [{"path": ["/default"]}],
              "handle": [
                {"handler": "cache"},
                {"handler": "static_response", "body": "Hello, default!"}
              ]
            },
            {
              "match": [{"path": ["/stale"]}],
              "handle": [
                {"handler": "cache", "ttl": "5s", "stale": "30s"},
                {"handler": "static_response", "body": "Hello, stale!"}
              ]
            },
            {
              "match": [{"path": ["/no-query"]}],
              "handle": [
                {"handler": "cache", "key": {"disable_query": true}},
                {"handler": "static_response", "body": "Hello, whatever the query!"}
              ]
            },
            {
              "match": [{"path": ["/proxy/*"]}],
              "handle": [
                {
                  "handler": "cache",
                  "mode": "strict",
                  "cache_name": "Another",
                  "default_cache_control": "public, max-age=60",
                  "max_cacheable_body_bytes": "100Mi",
                  "allowed_additional_status_codes": [404],
                  "lock_timeout": "5s",
                  "regex": {"exclude": "^/proxy/private/"}
                },
                {"handler": "reverse_proxy", "upstreams": [{"dial": "127.0.0.1:9000"}]}
              ]
            }
          ]
        }
      }
    }
  }
}
