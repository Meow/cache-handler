# A cache that conforms to RFC 9111 (HTTP Caching), see "Standards
# compliance" in the README. The defaults favor hit rate over the letter of
# the standard; this configuration takes the standard's side where they differ.
{
	cache {
		path /var/cache/caddy
		max_size 10Gi
		max_memory 256Mi

		# Honor request Cache-Control directives (no-cache, no-store, max-age,
		# min-fresh, max-stale, only-if-cached) and Pragma: no-cache, and store
		# a response to a request with Authorization only when it carries
		# public, s-maxage or must-revalidate (sections 4 and 3.5).
		mode strict

		# Heuristic freshness for responses that say nothing (section 4.2.2).
		# Any value is allowed; keep it short.
		ttl 2m

		# Left unset: a response is served stale only when it allows it
		# (stale-while-revalidate, stale-if-error, RFC 5861) or the request
		# does (max-stale). Section 4.2.4 permits a configured stale as an
		# "out-of-band contract" with the origin; set it knowingly.
		# stale 1h
	}
}

example.com {
	# No option that overrides the origin: no default_cache_control, no
	# allowed_additional_status_codes, no key { disable_vary }, and no
	# Authorization among key { headers }.
	cache
	reverse_proxy 127.0.0.1:9000
}
